<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="ticketssystem_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            Push is unconfigured under test unless a case configures it.
            Inherited from .env, the tests asserting "disabled without
            credentials" pass on a machine that has none and fail the moment a
            real service-account key is installed, which is exactly backwards.

            The project id is pinned rather than blanked: it is not a secret
            (it is already inlined in public/firebase-messaging-sw.js) and
            FirebaseMessagingWorkerTest compares the two. isConfigured()
            requires both halves, so blanking the credentials alone is what
            keeps push off.
        -->
        <env name="FCM_PROJECT_ID" value="swaida-tickets"/>
        <env name="FCM_CREDENTIALS" value=""/>
        <env name="FCM_ACCESS_TOKEN" value=""/>
    </php>
</phpunit>
