{
    "name": "Swaida Tickets Hub",
    "short_name": "Swaida Tickets",
    "description": "Reserve event tickets in Swaida and pay at the venue.",
    "start_url": "/my-tickets",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#E8E2D6",
