APP_NAME="Swaida Tickets Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Firebase Cloud Messaging (optional) -------------------------------------
# Push stays disabled while these are blank. To enable:
#   1. Create a Firebase project and enable Cloud Messaging
#   2. FCM_PROJECT_ID  = the Firebase project id
#   3. FCM_CREDENTIALS = absolute path to the service-account JSON
#   4. VITE_FCM_* keys = from Firebase Console > Project settings > Web app
#   5. VITE_FCM_VAPID_KEY = Cloud Messaging > Web Push certificates > key pair
#
# The two halves fail independently and are worth separating:
#   * VITE_FCM_VAPID_KEY missing  -> the browser is never asked for permission
#     at all. The opt-in does not render, which is deliberate: a prompt that
#     cannot produce a usable token is worse than no prompt.
#   * FCM_CREDENTIALS missing     -> devices register fine, nothing can be sent.
#
# VITE_* values are public and ship in the bundle. The service-account JSON is
# not; keep it outside the repository and point FCM_CREDENTIALS at its path.
FCM_PROJECT_ID=
FCM_CREDENTIALS=
FCM_ACCESS_TOKEN=

VITE_FCM_API_KEY=
VITE_FCM_PROJECT_ID=
VITE_FCM_SENDER_ID=
VITE_FCM_APP_ID=
VITE_FCM_AUTH_DOMAIN=
VITE_FCM_STORAGE_BUCKET=
VITE_FCM_MEASUREMENT_ID=
VITE_FCM_VAPID_KEY=
